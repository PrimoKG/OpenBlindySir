# OpenBlindySir Server - example configuration
#
# Copy this file to `.env` in the server working directory, then replace every REPLACE_ME value.
# For native PC hosting, tools/host_pc.py init generates a ready-to-edit private .env;
# see docs/deployment.md for LAN, VPN and public Internet access.
#
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed or shared.
# Every value in this file is fictional.
#
# ------------------------------------------------------------------------------------------
# Secrets
# ------------------------------------------------------------------------------------------
# The server refuses to start when a secret is missing, shorter than 12 characters
# (BRIDGE_SECRET: shorter than 32), equal to "changeme", or when HOST_PASSWORD equals
# BLIND_PASSWORD. REPLACE_ME is deliberately too short to pass these checks: a forgotten
# placeholder stops the server instead of running it with a publicly known password.
#
# Generate strong values with either:
#
#     openssl rand -base64 32
#     uv run openblindysir-server gen-secrets
#
# Native hosting configuration. For full Docker use docs/docker.md and its launcher;
# it generates .local/docker/hosting.env without host Python, Node.js or FFmpeg.

# Password your friends type to join the blind test. Share it with players only.
# At least 12 characters; a passphrase of several random words is easy to type.
BLIND_PASSWORD=REPLACE_ME

# Password that unlocks the host interface (/host). Keep it to yourself.
# At least 12 characters and different from BLIND_PASSWORD.
HOST_PASSWORD=REPLACE_ME

# Shared secret between the server and the OpenBlindySir Bridge running on your PC.
# At least 32 characters. Never give it to players.
BRIDGE_SECRET=REPLACE_ME

# ------------------------------------------------------------------------------------------
# Deployment
# ------------------------------------------------------------------------------------------
# Public domain name served by Caddy (HTTPS certificate from Let's Encrypt).
# Without a domain, a wildcard DNS name such as 203-0-113-10.sslip.io (your VPS IP) works too.
DOMAIN=openblindysir.example.com

# Only the actual reverse proxy may report client IP (X-Forwarded-For).
# Native and bundled Docker hosting use Caddy over loopback. Never use "*".
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# text (human readable) | json (one JSON object per line)
LOG_FORMAT=text

# true writes track titles and file names to the logs (spoilers and privacy). Keep false.
LOG_TRACK_NAMES=false

# ------------------------------------------------------------------------------------------
# Server limits (sensible defaults, change only if needed)
# ------------------------------------------------------------------------------------------
# Maximum number of players in the session.
MAX_PLAYERS=20

# Bounds for the clip duration the host can choose, in seconds.
CLIP_MIN_S=5
CLIP_MAX_S=60

# Clip format produced by the Bridge (aac = AAC-LC in .m4a). See docs/adr/0004-audio-format.md.
CLIP_FORMAT=aac

# Clip bitrate, in kbit/s.
CLIP_BITRATE=128

# RAM budget for prepared clips on the server, in MB.
AUDIO_CACHE_MB=32

# Maximum size of a single clip uploaded by the Bridge, in MB.
MAX_CLIP_MB=2

# Seconds to wait for players' audio to be ready before a round starts anyway.
READY_TIMEOUT_S=10

# Maximum length of an answer, in characters.
ANSWER_MAX_CHARS=200

# Two answers locked less than this many milliseconds apart are marked as a near tie
# (their order is not meaningful). Speed is shown to the host, it never awards points.
NEAR_TIE_MS=300

# The session ends after this many hours without activity.
SESSION_IDLE_TTL_H=24

# Private atomic session snapshots, score journal and completed game history.
# Keep this directory on persistent storage; it contains answers and hashed session tokens.
STATE_DIR=.local/state

# ------------------------------------------------------------------------------------------
# Development
# ------------------------------------------------------------------------------------------
# Non-Secure cookie, weak passwords tolerated, verbose logs.
# DEV_MODE=1  # never in production
